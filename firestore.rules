rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'Lgu06oPJ40MESrZVChme6svrMB52';
    }

    function isBanned(uid) {
      return exists(/databases/$(database)/documents/privateAccounts/$(uid))
        && get(/databases/$(database)/documents/privateAccounts/$(uid)).data.get('banned', false) == true;
    }

    function canDeleteOwnData(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.time.toMillis() - request.auth.token.auth_time * 1000 < 300000
        && !isBanned(uid);
    }

    function validPublicProfile(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly([
          'username', 'favorites', 'topFavorites', 'passport', 'personalBest',
          'nameBreedBest', 'photoQuizBest', 'lastDailyScore', 'lastDailyDate',
          'createdAt', 'updatedAt', 'favoriteOfAll', 'stampOrder'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && !request.resource.data.username.matches('.*(asshole|bastard|bitch|cock|cunt|dick|dildo|fuck|motherfucker|nigger|nigga|piss|porn|pussy|rape|rapist|retard|shit|slut|twat|vagina|whore).*')
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
        && request.resource.data.favorites is list
        && request.resource.data.favorites.size() <= 300
        && request.resource.data.topFavorites is list
        && request.resource.data.topFavorites.size() <= 300
        && request.resource.data.passport is list
        && request.resource.data.passport.size() <= 300
        && request.resource.data.get('favoriteOfAll', '') is string
        && (request.resource.data.get('favoriteOfAll', '') == ''
          || request.resource.data.get('favoriteOfAll', '') in request.resource.data.favorites)
        && request.resource.data.get('stampOrder', []) is list
        && request.resource.data.get('stampOrder', []).size() <= 300
        && request.resource.data.passport.hasAll(request.resource.data.get('stampOrder', []))
        && request.resource.data.personalBest is int
        && request.resource.data.personalBest >= 0
        && request.resource.data.personalBest <= 40000
        && request.resource.data.nameBreedBest is int
        && request.resource.data.nameBreedBest >= 0
        && request.resource.data.nameBreedBest <= 8
        && request.resource.data.photoQuizBest is int
        && request.resource.data.photoQuizBest >= 0
        && request.resource.data.photoQuizBest <= 8
        && request.resource.data.lastDailyScore is int
        && request.resource.data.lastDailyScore >= 0
        && request.resource.data.lastDailyScore <= 40000
        && request.resource.data.lastDailyDate is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validPrivateAccount(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'username', 'createdAt', 'banned', 'moderatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && !request.resource.data.username.matches('.*(asshole|bastard|bitch|cock|cunt|dick|dildo|fuck|motherfucker|nigger|nigga|piss|porn|pussy|rape|rapist|retard|shit|slut|twat|vagina|whore).*')
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.banned == false
        && request.resource.data.moderatedAt is timestamp;
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['initials', 'score', 'dayKey', 'uid', 'playedAt'])
        && request.resource.data.uid == request.auth.uid
        && entryId == request.resource.data.dayKey + '_' + request.auth.uid
        && request.resource.data.initials is string
        && request.resource.data.initials.matches('^[A-Z0-9]{2,3}$')
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 40000
        && request.resource.data.dayKey is string
        && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.playedAt is timestamp;
      allow update: if false;
      allow delete: if isAdmin() || canDeleteOwnData(resource.data.uid);
    }

    // Atomic, monotonic lifetime votes: one heart and at most one bonus of each
    // kind per authenticated identity. Public totals never expose voter IDs.
    function favoriteIncrement(breedId, key) {
      let path = /databases/$(database)/documents/breedHearts/$(breedId + '_' + request.auth.uid);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return key == 'hearts' ? (exists(path) ? 0 : 1)
        : (after.get(key, false) ? 1 : 0) - (before.get(key, false) ? 1 : 0);
    }
    function validPopularity(breedId) {
      let path = /databases/$(database)/documents/breedPopularity/$(breedId);
      let before = exists(path) ? get(path).data : {'hearts': 0, 'top': 0, 'crown': 0};
      let after = getAfter(path).data;
      return after.keys().hasOnly(['hearts', 'top', 'crown'])
        && after.hearts is int && after.top is int && after.crown is int
        && after.hearts == before.hearts + favoriteIncrement(breedId, 'hearts')
        && after.top == before.top + favoriteIncrement(breedId, 'top')
        && after.crown == before.crown + favoriteIncrement(breedId, 'crown')
        && after.hearts + after.top + after.crown > before.hearts + before.top + before.crown;
    }
    match /breedPopularity/{breedId} {
      allow read: if true;
      allow create, update: if request.auth != null && !isBanned(request.auth.uid)
        && (validPopularity(breedId) || validPopularityRemoval(breedId));
      allow delete: if false;
    }
    function validPopularityRemoval(breedId) {
      let votePath = /databases/$(database)/documents/breedHearts/$(breedId + '_' + request.auth.uid);
      let statsPath = /databases/$(database)/documents/breedPopularity/$(breedId);
      let vote = get(votePath).data;
      let before = get(statsPath).data;
      let after = getAfter(statsPath).data;
      return canDeleteOwnData(request.auth.uid)
        && !existsAfter(votePath)
        && after.keys().hasOnly(['hearts', 'top', 'crown'])
        && after.hearts is int && after.top is int && after.crown is int
        && after.hearts >= 0 && after.top >= 0 && after.crown >= 0
        && after.hearts == before.hearts - 1
        && after.top == before.top - (vote.get('top', false) ? 1 : 0)
        && after.crown == before.crown - (vote.get('crown', false) ? 1 : 0);
    }
    // One document per browser account and breed; owners may remove it during
    // reauthenticated account deletion. Other players cannot read these records.
    match /breedHearts/{heartId} {
      allow get: if request.auth != null && heartId.matches('^[a-z0-9-]{2,80}_' + request.auth.uid + '$');
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['breedId', 'uid', 'heartedAt', 'top', 'crown'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.breedId is string
        && request.resource.data.breedId.matches('^[a-z0-9-]{2,80}$')
        && heartId == request.resource.data.breedId + '_' + request.auth.uid
        && request.resource.data.heartedAt is timestamp
        && request.resource.data.top is bool && request.resource.data.crown is bool
        && validPopularity(request.resource.data.breedId);
      allow update: if request.auth != null && !isBanned(request.auth.uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['top', 'crown'])
        && request.resource.data.top is bool && request.resource.data.crown is bool
        && (!resource.data.get('top', false) || request.resource.data.top)
        && (!resource.data.get('crown', false) || request.resource.data.crown)
        && validPopularity(resource.data.breedId);
      allow delete: if canDeleteOwnData(resource.data.uid)
        && validPopularityRemoval(resource.data.breedId);
    }

    // Quality reports contain only public photo metadata and the selected reason;
    // no player identifier is stored. Only the administrator can read reports.
    match /photoReports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['photoId', 'breedId', 'photoUrl', 'reason', 'reportedAt'])
        && reportId.matches('^[0-9a-f-]{36}$')
        && request.resource.data.photoId is string
        && request.resource.data.photoId.matches('^[a-z0-9]{1,20}$')
        && request.resource.data.breedId is string
        && request.resource.data.breedId.matches('^[a-z0-9-]{2,80}$')
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2000
        && request.resource.data.reason in ['not-loading', 'horse-too-small', 'person-visible', 'not-color-photo', 'wrong-breed', 'other']
        && request.resource.data.reportedAt is timestamp;
      allow update, delete: if false;
    }

    // Public player pages deliberately exclude email addresses. Owners can
    // update only their own profile, while anyone may open a shared profile.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create: if validPublicProfile(uid);
      allow update: if validPublicProfile(uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canDeleteOwnData(uid);
    }

    // Email is stored separately because Firestore reads are document-level:
    // a public profile can never accidentally reveal a private field.
    match /privateAccounts/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if validPrivateAccount(uid);
      allow update: if (validPrivateAccount(uid)
          && !isBanned(uid)
          && request.resource.data.createdAt == resource.data.createdAt
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'moderatedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'moderatedAt'])
          && request.resource.data.banned is bool
          && request.resource.data.moderatedAt is timestamp);
      allow delete: if canDeleteOwnData(uid);
    }

    // Lowercase document IDs reserve usernames atomically at the database
    // layer. Reservations cannot be reassigned, but account deletion releases them.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && username.matches('^[a-z0-9_]{3,20}$')
        && !username.matches('.*(asshole|bastard|bitch|cock|cunt|dick|dildo|fuck|motherfucker|nigger|nigga|piss|porn|pussy|rape|rapist|retard|shit|slut|twat|vagina|whore).*')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if canDeleteOwnData(resource.data.uid);
    }
  }
}
